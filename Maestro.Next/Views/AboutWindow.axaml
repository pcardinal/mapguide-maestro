<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Maestro.Next.Views.AboutWindow"
        Title="About MapGuide Maestro"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

  <StackPanel Margin="24" Spacing="12" VerticalAlignment="Center">
    <TextBlock Text="🗺 MapGuide Maestro"
               FontSize="24" FontWeight="SemiBold"
               HorizontalAlignment="Center" />

    <TextBlock Text="Next Generation"
               FontSize="14" Foreground="Gray"
               HorizontalAlignment="Center" />

    <Separator />

    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="Gray" FontSize="12">
      Cross-platform MapGuide authoring and administration tool.
      Rebuilt from the ground up with Avalonia UI on .NET 10.
    </TextBlock>

    <StackPanel Spacing="4" HorizontalAlignment="Center">
      <TextBlock HorizontalAlignment="Center">
        <Run Text="Runtime: " FontWeight="SemiBold" />
        <Run Text="See below" />
      </TextBlock>
      <TextBlock x:Name="RuntimeTextBlock"
                 HorizontalAlignment="Center"
                 FontFamily="Consolas,Monospace" FontSize="11" />
      <TextBlock HorizontalAlignment="Center">
        <Run Text="Avalonia: " FontWeight="SemiBold" />
        <Run Text="12.0" />
      </TextBlock>
    </StackPanel>

    <Separator />

    <TextBlock Text="© 2010–2025 Jackie Ng and contributors"
               FontSize="11" Foreground="Gray"
               HorizontalAlignment="Center" />
    <TextBlock Text="GNU Lesser General Public License v2.1"
               FontSize="11" Foreground="Gray"
               HorizontalAlignment="Center" />

    <Button Content="Close"
            Click="OnCloseClick"
            HorizontalAlignment="Center"
            Padding="24,6"
            Margin="0,8,0,0" />
  </StackPanel>
</Window>
