<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Maestro.Next.ViewModels"
             xmlns:editors="using:Maestro.Next.Views.Editors"
             x:Class="Maestro.Next.Views.DocumentAreaView"
             x:DataType="vm:DocumentManagerViewModel">

  <Panel>
    <!-- Empty state -->
    <StackPanel IsVisible="{Binding !HasOpenDocuments}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
      <TextBlock Text="No documents open"
                 HorizontalAlignment="Center"
                 Foreground="Gray" FontSize="14" />
      <TextBlock Text="Double-click a resource in the Site Explorer to open it"
                 HorizontalAlignment="Center"
                 Foreground="Gray" FontSize="11" />
    </StackPanel>

    <!-- Tab + Validation area when documents are open -->
    <Grid IsVisible="{Binding HasOpenDocuments}"
          RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                ItemsSource="{Binding OpenDocuments}"
                SelectedItem="{Binding ActiveDocument}">

      <!-- Tab header template -->
      <TabControl.ItemTemplate>
        <DataTemplate DataType="vm:DocumentViewModel">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            <TextBlock Text="●" Foreground="Orange"
                       FontSize="10" VerticalAlignment="Center"
                       IsVisible="{Binding IsDirty}" />
            <Button Content="✕"
                    Command="{Binding $parent[TabControl].((vm:DocumentManagerViewModel)DataContext).CloseDocumentCommand}"
                    CommandParameter="{Binding}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="2,0"
                    FontSize="11"
                    VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>

      <!-- Dispatches to the correct editor view by ViewModel type -->
      <TabControl.ContentTemplate>
        <DataTemplate DataType="vm:DocumentViewModel">
          <ContentControl Content="{Binding}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:FeatureSourceEditorViewModel">
                <editors:FeatureSourceEditorView />
              </DataTemplate>
              <DataTemplate DataType="vm:LayerDefinitionEditorViewModel">
                <editors:LayerDefinitionEditorView />
              </DataTemplate>
              <DataTemplate DataType="vm:MapDefinitionEditorViewModel">
                <editors:MapDefinitionEditorView />
              </DataTemplate>
              <DataTemplate DataType="vm:WebLayoutEditorViewModel">
                <editors:WebLayoutEditorView />
              </DataTemplate>
              <DataTemplate DataType="vm:ApplicationDefinitionEditorViewModel">
                <editors:ApplicationDefinitionEditorView />
              </DataTemplate>
              <DataTemplate DataType="vm:SymbolDefinitionEditorViewModel">
                <editors:SymbolDefinitionEditorView />
              </DataTemplate>
              <DataTemplate DataType="vm:GenericResourceEditorViewModel">
                <editors:GenericResourceEditorView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </DataTemplate>
      </TabControl.ContentTemplate>

    </TabControl>

    <!-- Validation results panel -->
    <Border Grid.Row="1"
            IsVisible="{Binding ActiveDocument.HasValidationIssues}"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="0,1,0,0"
            MaxHeight="180">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6" Spacing="8">
          <TextBlock Text="Validation Issues" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ActiveDocument.ValidationIssues.Count, StringFormat='({0})'}"
                     Foreground="Gray" VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding ActiveDocument.ValidationIssues}" Margin="8,0,8,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ValidationIssueViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                  <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                             FontSize="12" MaxWidth="700" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    </Grid>
  </Panel>
</UserControl>
