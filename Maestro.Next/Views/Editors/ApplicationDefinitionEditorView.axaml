<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Maestro.Next.ViewModels"
             x:Class="Maestro.Next.Views.Editors.ApplicationDefinitionEditorView"
             x:DataType="vm:ApplicationDefinitionEditorViewModel">

  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8,6">
      <Button Content="💾 Save"
              Command="{Binding SaveCommand}"
              IsEnabled="{Binding IsDirty}"
              Classes="accent" />
      <Button Content="✓ Validate"
              Command="{Binding ValidateCommand}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                   Width="80" Height="8" VerticalAlignment="Center" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,4,*">

      <!-- Left: General + Map Groups -->
      <ScrollViewer Grid.Column="0" Margin="8,0,4,8">
        <StackPanel Spacing="12">

          <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  CornerRadius="4" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Fusion Layout" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title"
                           VerticalAlignment="Center" />
                <TextBox   Grid.Row="0" Grid.Column="1"
                           Text="{Binding LayoutTitle}" Margin="8,2,0,2" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Template URL"
                           VerticalAlignment="Center" />
                <TextBox   Grid.Row="1" Grid.Column="1"
                           Text="{Binding TemplateUrl}"
                           FontFamily="Consolas,Monospace" FontSize="11"
                           Margin="8,2,0,2" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  CornerRadius="4" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Map Groups" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding MapGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:FusionMapGroupViewModel">
                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            BorderThickness="0,0,0,1" Padding="0,6">
                      <StackPanel Spacing="4">
                        <TextBlock>
                          <Run Text="Group: " FontWeight="SemiBold" />
                          <Run Text="{Binding Id}" FontFamily="Consolas,Monospace" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Maps}" Margin="12,0,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:FusionMapViewModel">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🗺" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MapDefinitionId}"
                                           FontFamily="Consolas,Monospace" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="220" />
                                <TextBlock Text="(tiled)"
                                           FontSize="10" Foreground="Gray"
                                           IsVisible="{Binding SingleTile}"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- Right: Widget Sets -->
      <ScrollViewer Grid.Column="2" Margin="4,0,8,8">
        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="4" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Widget Sets" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding WidgetSets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:FusionWidgetSetViewModel">
                  <ItemsControl ItemsSource="{Binding Widgets}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:FusionWidgetViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                          <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                  CornerRadius="2" Padding="4,2" MinWidth="80">
                            <TextBlock Text="{Binding Type}"
                                       FontSize="10" Foreground="Gray" />
                          </Border>
                          <TextBlock Text="{Binding Name}"
                                     VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
