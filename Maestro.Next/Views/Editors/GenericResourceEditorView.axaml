<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Maestro.Next.ViewModels"
             x:Class="Maestro.Next.Views.Editors.GenericResourceEditorView"
             x:DataType="vm:GenericResourceEditorViewModel">

  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8,6">
      <Button Content="💾 Save"
              Command="{Binding SaveCommand}"
              IsEnabled="{Binding IsDirty}"
              Classes="accent" />
      <Button Content="✓ Validate"
              Command="{Binding ValidateCommand}" />
      <TextBlock Text="{Binding ResourceType}"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Margin="8,0,0,0" />
      <TextBlock Text="— XML Editor"
                 Foreground="Gray" FontSize="11"
                 VerticalAlignment="Center"
                 Margin="4,0,0,0" />
      <ProgressBar IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}"
                   Width="100" Height="8"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0" />
    </StackPanel>

    <TextBox Grid.Row="1"
             Text="{Binding XmlContent}"
             FontFamily="Consolas,Monospace"
             FontSize="12"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             Margin="8,0,8,8" />
  </Grid>
</UserControl>
