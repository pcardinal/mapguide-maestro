<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Maestro.Next.ViewModels"
             x:Class="Maestro.Next.Views.Editors.GenericResourceEditorView"
             x:DataType="vm:GenericResourceEditorViewModel">

  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8,6">
      <TextBlock Text="{Binding ResourceType}"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <TextBlock Text="— XML view (full editor coming soon)"
                 Foreground="Gray" FontSize="11"
                 VerticalAlignment="Center" />
      <ProgressBar IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}"
                   Width="100" Height="8"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0" />
    </StackPanel>

    <TextBox Grid.Row="1"
             Text="{Binding XmlContent}"
             FontFamily="Consolas,Monospace"
             FontSize="12"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             Margin="8,0,8,8" />
  </Grid>
</UserControl>
