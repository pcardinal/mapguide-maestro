<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Maestro.Next.ViewModels"
             x:Class="Maestro.Next.Views.Editors.XmlEditorView"
             x:DataType="vm:XmlEditorViewModel">

  <Grid RowDefinitions="Auto,*">
    <!-- Toolbar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8,6">
      <Button Content="💾 Save"
              Command="{Binding SaveCommand}"
              IsEnabled="{Binding IsDirty}"
              Classes="accent" />
      <Button Content="⟲ Reload"
              Command="{Binding LoadCommand}" />
      <Button Content="📊 Diff"
              Command="{Binding ToggleDiffCommand}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                   Width="80" Height="8" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Editor area -->
    <Grid Grid.Row="1" Margin="8,0,8,8">
      <!-- Normal XML editing -->
      <TextBox Text="{Binding XmlContent}"
               AcceptsReturn="True"
               AcceptsTab="True"
               TextWrapping="NoWrap"
               FontFamily="Consolas,Monospace"
               FontSize="12"
               IsVisible="{Binding !ShowDiff}" />

      <!-- Diff view (side-by-side) -->
      <Grid ColumnDefinitions="*,4,*" IsVisible="{Binding ShowDiff}">
        <Border Grid.Column="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="4" Padding="4">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Server Version" FontWeight="SemiBold"
                       Margin="4,2" FontSize="11" />
            <TextBox Text="{Binding ServerXml}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas,Monospace"
                     FontSize="11" />
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <Border Grid.Column="2"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="4" Padding="4">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Local Changes" FontWeight="SemiBold"
                       Margin="4,2" FontSize="11" />
            <TextBox Text="{Binding XmlContent}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas,Monospace"
                     FontSize="11" />
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
