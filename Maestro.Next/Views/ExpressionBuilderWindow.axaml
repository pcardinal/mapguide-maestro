<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Maestro.Next.ViewModels"
        x:Class="Maestro.Next.Views.ExpressionBuilderWindow"
        x:DataType="vm:ExpressionBuilderViewModel"
        Title="FDO Expression Builder"
        Width="700" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">

  <Grid RowDefinitions="*,Auto,Auto" Margin="12">

    <!-- Top: 3 columns — Properties | Functions | Operators -->
    <Grid Grid.Row="0" ColumnDefinitions="*,4,*,4,Auto">

      <!-- Properties -->
      <Border Grid.Column="0"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Properties" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ListBox ItemsSource="{Binding Properties}"
                   DoubleTapped="OnPropertyDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ExpressionPropertyItem">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Icon}" FontSize="12" />
                  <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                  <TextBlock Text="{Binding DataType}" FontSize="10" Foreground="Gray" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- Functions -->
      <Border Grid.Column="2"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Functions" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ListBox ItemsSource="{Binding Functions}"
                   DoubleTapped="OnFunctionDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ExpressionFunctionItem">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" />
                  <TextBlock Text="{Binding Description}" FontSize="10"
                             Foreground="Gray" TextWrapping="Wrap" MaxWidth="200" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <!-- Operators -->
      <Border Grid.Column="4"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              CornerRadius="4" Padding="8" MinWidth="100">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Operators" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding Operators}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Content="{Binding}"
                        Margin="2"
                        Padding="6,3"
                        FontFamily="Consolas,Monospace"
                        FontSize="11"
                        Click="OnOperatorClick" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Expression text area -->
    <Border Grid.Row="1" Margin="0,8,0,0"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            CornerRadius="4" Padding="8">
      <StackPanel Spacing="4">
        <TextBlock Text="Expression" FontWeight="SemiBold" />
        <TextBox Text="{Binding ExpressionText}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="Consolas,Monospace"
                 FontSize="12"
                 MinHeight="80"
                 MaxHeight="120" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="✓ Validate"
                  Command="{Binding ValidateCommand}"
                  Padding="8,3" FontSize="11" />
          <TextBlock Text="{Binding ValidationResult}"
                     FontSize="11"
                     VerticalAlignment="Center"
                     IsVisible="{Binding ValidationResult,
                                 Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Click="OnCancelClick" Width="90" />
      <Button Content="OK"
              Command="{Binding ConfirmCommand}"
              Click="OnOkClick"
              Classes="accent" Width="90" />
    </StackPanel>
  </Grid>
</Window>
