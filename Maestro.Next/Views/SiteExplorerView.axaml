<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Maestro.Next.ViewModels"
             x:Class="Maestro.Next.Views.SiteExplorerView"
             x:DataType="vm:SiteExplorerViewModel">

  <DockPanel>
    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="2" Margin="4,4,4,2">
      <TextBlock Text="Site Explorer"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Margin="4,0,8,0" />
      <Button Content="＋"
              Command="{Binding NewResourceCommand}"
              ToolTip.Tip="New resource…"
              Padding="4,2" FontSize="14" />
      <Button Content="↻"
              Command="{Binding RefreshCommand}"
              ToolTip.Tip="Refresh"
              Padding="4,2" FontSize="14" />
      <Button Content="🗑"
              Command="{Binding DeleteSelectedCommand}"
              ToolTip.Tip="Delete selected resource"
              Padding="4,2" FontSize="13" />
    </StackPanel>

    <!-- Search bar -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,2">
      <TextBox Grid.Column="0"
               Text="{Binding SearchText}"
               PlaceholderText="Search resources..."
               Margin="0,0,4,0" />
      <Button Grid.Column="1"
              Content="✕"
              Command="{Binding ClearSearchCommand}"
              IsVisible="{Binding IsSearchActive}"
              Padding="6,2" />
    </Grid>

    <!-- Loading indicator -->
    <ProgressBar DockPanel.Dock="Top"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}"
                 Height="2" />

    <!-- Error message -->
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding ErrorMessage}"
               Foreground="Red"
               IsVisible="{Binding ErrorMessage,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Margin="8,4"
               TextWrapping="Wrap" />

    <!-- Search results (shown when search is active) -->
    <ListBox DockPanel.Dock="Top"
             x:Name="SearchResultsList"
             IsVisible="{Binding IsSearchActive}"
             ItemsSource="{Binding SearchResults}"
             SelectedItem="{Binding SelectedNode}"
             MaxHeight="300">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:ResourceTreeNode">
          <StackPanel Orientation="Horizontal" Spacing="6"
                      ToolTip.Tip="{Binding ResourceId}">
            <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" />
            <StackPanel>
              <TextBlock Text="{Binding Name}" />
              <TextBlock Text="{Binding ResourceId}"
                         FontSize="10" Foreground="Gray"
                         TextTrimming="CharacterEllipsis" MaxWidth="200" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Resource tree (hidden when search active) -->
    <TreeView x:Name="ResourceTree"
              IsVisible="{Binding !IsSearchActive}"
              ItemsSource="{Binding RootNodes}"
              SelectedItem="{Binding SelectedNode}"
              Margin="2"
              DragDrop.AllowDrop="True">

      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}"
                          x:DataType="vm:ResourceTreeNode">
          <StackPanel Orientation="Horizontal" Spacing="6"
                      ToolTip.Tip="{Binding ResourceId}">
            <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            <Border IsVisible="{Binding !IsFolder}"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="2" Padding="3,1">
              <TextBlock Text="{Binding ResourceType}"
                         FontSize="10" Foreground="Gray" />
            </Border>
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>

      <!-- Context menu -->
      <TreeView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open"
                    Command="{Binding OpenResourceCommand}"
                    CommandParameter="{Binding SelectedNode}" />
          <MenuItem Header="Edit as XML"
                    Command="{Binding OpenAsXmlCommand}" />
          <Separator />
          <MenuItem Header="New Resource..."
                    Command="{Binding NewResourceCommand}" />
          <MenuItem Header="Rename..."
                    Command="{Binding RenameSelectedCommand}" />
          <MenuItem Header="Duplicate..."
                    Command="{Binding CopySelectedCommand}" />
          <Separator />
          <MenuItem Header="Cut"
                    Command="{Binding CutSelectedCommand}"
                    InputGesture="Ctrl+X" />
          <MenuItem Header="Copy"
                    Command="{Binding CopyToClipboardCommand}"
                    InputGesture="Ctrl+C" />
          <MenuItem Header="Paste"
                    Command="{Binding PasteCommand}"
                    InputGesture="Ctrl+V" />
          <MenuItem Header="Copy Resource ID"
                    Command="{Binding CopyResourceIdCommand}" />
          <MenuItem Header="Save to Disk..."
                    Command="{Binding SaveToDiskCommand}" />
          <MenuItem Header="Spatial Contexts..."
                    Command="{Binding ShowSpatialContextsCommand}" />
          <MenuItem Header="Purge Cache"
                    Command="{Binding PurgeCacheCommand}" />
          <MenuItem Header="Repoint..."
                    Command="{Binding RepointCommand}" />
          <MenuItem Header="Dependencies..."
                    Command="{Binding ShowDependenciesCommand}" />
          <Separator />
          <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
          <Separator />
          <MenuItem Header="Properties..."
                    Command="{Binding ShowPropertiesCommand}" />
          <MenuItem Header="Delete"
                    Command="{Binding DeleteSelectedCommand}" />
        </ContextMenu>
      </TreeView.ContextMenu>
    </TreeView>
  </DockPanel>
</UserControl>
