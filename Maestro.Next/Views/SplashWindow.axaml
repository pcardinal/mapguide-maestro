<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Maestro.Next.Views.SplashWindow"
        Title="MapGuide Maestro"
        Width="400" Height="200"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="#1E1E2E"
        TransparencyLevelHint="None">

  <Border CornerRadius="8" BorderBrush="#444" BorderThickness="1"
          Background="#1E1E2E" ClipToBounds="True">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <TextBlock Text="🗺️ MapGuide Maestro"
                 FontSize="28" FontWeight="Bold"
                 Foreground="White"
                 HorizontalAlignment="Center" />
      <TextBlock Text="Next Generation — Cross-Platform"
                 FontSize="13" Foreground="#AAA"
                 HorizontalAlignment="Center" />
      <ProgressBar IsIndeterminate="True"
                   Width="200" Height="4"
                   Margin="0,8,0,0" />
      <TextBlock Text="Loading..."
                 FontSize="11" Foreground="#888"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
