<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Maestro.Next.ViewModels"
        x:Class="Maestro.Next.Views.ThemeWizardWindow"
        x:DataType="vm:ThemeWizardViewModel"
        Title="Theme Generation Wizard"
        Width="520" Height="450"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

    <!-- Property selector -->
    <Grid Grid.Row="0" ColumnDefinitions="80,*,70,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Property:" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding PropertyNames}"
                SelectedItem="{Binding SelectedPropertyName}" />
      <TextBlock Grid.Column="2" Text="Max:" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Margin="8,0,4,0" />
      <NumericUpDown Grid.Column="3" Value="{Binding MaxValues}"
                     Minimum="1" Maximum="500" Width="80" />
    </Grid>

    <!-- Values list -->
    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Values}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ThemeValueItem">
              <Grid ColumnDefinitions="Auto,*,100" Margin="4,2">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}"
                           FontFamily="Consolas,Monospace" FontSize="11"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Text="{Binding ColorHex}"
                         FontFamily="Consolas,Monospace" FontSize="10"
                         Padding="2" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Status -->
    <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4" />
      <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" FontSize="11" />
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Row="3" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="Load Values"
              Command="{Binding LoadValuesCommand}" Width="110" />
      <Button Content="Close" Click="OnCloseClick" Width="80" />
      <Button Content="Generate Rules"
              Command="{Binding GenerateCommand}"
              Click="OnGenerateClick"
              Classes="accent" Width="120" />
    </StackPanel>
  </Grid>
</Window>
